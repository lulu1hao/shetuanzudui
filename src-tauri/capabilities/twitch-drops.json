{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "twitch-drops",
  "description": "Allows isolated Twitch WebView2 windows to report playback and Drops state only.",
  "windows": ["twitch-drops-*"],
  "remote": {
    "urls": [
      "https://twitch.tv/*",
      "https://*.twitch.tv/*"
    ]
  },
  "permissions": [
    "core:event:allow-emit"
  ]
}
